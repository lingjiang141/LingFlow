{
  "name": "lingflow-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LingFlow 侧边栏面板：在 DSH 里查看项目、团队、任务与协作动态，完成角色绑定、启停和提示词配置；与独立窗口共用同一个本地服务。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
